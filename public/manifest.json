{
  "manifest_version": 3,
  "name": "One-Click Account Swapper",
  "version": "1.0.0",
  "description": "Securely swap between multiple accounts on Claude, ChatGPT, Gemini, GitHub, Discord, Notion, Slack, and more with one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://*.google.com/*",
    "*://*.gemini.google.com/*",
    "*://*.github.com/*",
    "*://*.discord.com/*",
    "*://*.slack.com/*",
    "*://*.notion.so/*",
    "*://*.figma.com/*",
    "*://*.reddit.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.linkedin.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "swap_next_account": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Swap to next pinned account for the active website"
    }
  }
}
